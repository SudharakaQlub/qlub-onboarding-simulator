+const QI = 64 // mascot size
+const GAP = 14
+const BUBBLE_W = 300
+const BUBBLE_H = 250 // room kept for the bubble when placing Qi
+
+interface Spot {
+  top: number
+  left: number
+  width: number
+  height: number
+}
+interface Place {
+  left: number
+  top: number
+  side: 'right' | 'left'
+  up: boolean
+}
+
+function corner(vw: number, vh: number): Place {
+  return { left: vw - QI - 24, top: vh - QI - 22, side: 'left', up: true }
+}
+
+/** Where Qi sits next to a highlighted element, with its bubble on the side away from it. */
+function placeBy(r: Spot, vw: number, vh: number): Place {
+  const clampTop = (t: number) => Math.min(Math.max(t, 8), vh - QI - 8)
+  const clampLeft = (l: number) => Math.min(Math.max(l, 8), vw - QI - 8)
+  const need = QI + 12 + BUBBLE_W + 8
+  const midTop = clampTop(r.top + r.height / 2 - QI / 2)
+  const up = (top: number) => top + BUBBLE_H > vh - 8
+  if (r.left + r.width + GAP + need <= vw) return { left: r.left + r.width + GAP, top: midTop, side: 'right', up: up(midTop) }
+  if (r.left - GAP - need >= 0) return { left: r.left - GAP - QI, top: midTop, side: 'left', up: up(midTop) }
+  const sideFor = (left: number): 'right' | 'left' => (left + need <= vw ? 'right' : 'left')
+  const left = clampLeft(r.left + Math.min(r.width, 260) / 2 - QI / 2)
+  if (r.top + r.height + GAP + QI <= vh - 8) {
+    const top = r.top + r.height + GAP
+    return { left, top, side: sideFor(left), up: up(top) }
+  }
+  if (r.top - GAP - QI >= 8) return { left, top: r.top - GAP - QI, side: sideFor(left), up: true }
+  return corner(vw, vh)
