+import { useEffect, useMemo, useRef, useState } from 'react'
+import { IconClose, IconMic, IconMute, IconPlay, IconSearch, IconVolume } from './Icons'
+import { answerVenue, DATA_QUESTIONS } from '../training/venueAnswers'
+import { speak, useListen } from '../training/voice'
+import type { Faq, TrainingPack } from '../training/types'
+import { useStore, type PageKey } from '../store'
+
+export const BOT_NAME = 'Qubi'
+
+const TIPS: Partial<Record<PageKey, string>> = {
+  training: 'Stuck on something? Ask me how to do it, or about this venue’s numbers.',
+  dashboard: 'Want to know what a figure means? Ask me.',
+  orders: 'Looking for an order? I can help you find it.',
+  payments: 'Need to match a payment or issue a refund? Ask me how.',
+  tableView: 'Want to know which tables still owe? Just ask.',
+}
+
+const STOP = new Set(['the', 'and', 'how', 'what', 'did', 'does', 'was', 'were', 'are', 'can', 'for', 'our', 'this', 'that', 'last', 'week', 'month', 'days', 'with', 'from', 'will', 'have', 'has', 'get', 'see', 'you', 'they', 'their', 'who', 'which', 'why', 'when', 'today', 'yesterday', 'much', 'many'])
+
+function score(f: Faq, q: string) {
+  const words = q.toLowerCase().split(/\W+/).filter((w) => w.length > 2 && !STOP.has(w))
+  if (!words.length) return 0
+  const hay = `${f.q} ${f.a} ${(f.keywords ?? []).join(' ')}`.toLowerCase()
+  return words.reduce((s, w) => s + (hay.includes(w) ? 1 : 0), 0)
+}
+
+/** Friendly floating helper that lives in the bottom-right corner on every page. */
+export function HelperBot() {
+  const { tour, page } = useStore()
+  const [open, setOpen] = useState(false)
+  const [tip, setTip] = useState<string | null>(null)
+  const [tipSeen, setTipSeen] = useState(false)
+
+  // Peek out with a tip a few seconds after landing, once per session.
+  useEffect(() => {
+    if (open || tipSeen) return
+    const t = window.setTimeout(() => setTip(TIPS[page] ?? TIPS.training!), 2500)
+    return () => window.clearTimeout(t)
+  }, [page, open, tipSeen])
+
+  useEffect(() => {
+    if (!tip) return
+    const t = window.setTimeout(() => {
+      setTip(null)
+      setTipSeen(true)
+    }, 9000)
+    return () => window.clearTimeout(t)
+  }, [tip])
+
+  useEffect(() => {
+    if (!open) return
+    const onKey = (e: KeyboardEvent) => e.key === 'Escape' && setOpen(false)
+    window.addEventListener('keydown', onKey)
+    return () => window.removeEventListener('keydown', onKey)
+  }, [open])
+
+  // Keep out of the way while a guided lesson is running.
+  if (tour) return null
+
+  const toggle = () => {
+    setTip(null)
+    setTipSeen(true)
+    setOpen((o) => !o)
+  }
+
+  return (
+    <div className={`helper ${open ? 'is-open' : ''}`} data-tour="helper">
+      {open && <HelperPanel onClose={() => setOpen(false)} />}
+      {!open && tip && (
+        <div className="helper-tip" role="status">
+          <button className="helper-tip-text" onClick={toggle}>
+            {tip}
+          </button>
+          <button
+            className="icon-btn"
+            aria-label="Dismiss"
+            onClick={() => {
+              setTip(null)
+              setTipSeen(true)
+            }}
+          >
+            <IconClose size={12} />
+          </button>
+        </div>
+      )}
+      <button
+        className="helper-fab"
+        onClick={toggle}
+        aria-label={open ? `Close ${BOT_NAME}` : `Ask ${BOT_NAME} a question`}
+        title={open ? 'Close' : `Ask ${BOT_NAME}`}
+        data-tour="helper-open"
+      >
+        <Mascot />
+      </button>
+    </div>
+  )
+}
+
+/** Original mascot: a little speech-bubble buddy with blinking eyes. */
+export function Mascot({ size = 64 }: { size?: number }) {
+  return (
+    <svg className="mascot" width={size} height={size} viewBox="0 0 64 64" aria-hidden>
+      <defs>
+        <linearGradient id="mascot-body" x1="0" y1="0" x2="0" y2="1">
+          <stop offset="0" stopColor="#9a2bea" />
+          <stop offset="1" stopColor="#6a00b5" />
+        </linearGradient>
+      </defs>
+      <ellipse cx="32" cy="60" rx="16" ry="2.5" fill="rgba(40,0,70,.18)" className="mascot-shadow" />
+      <g className="mascot-body">
+        <line x1="32" y1="9" x2="32" y2="3" stroke="#7d00d4" strokeWidth="2.5" strokeLinecap="round" />
+        <circle cx="32" cy="3.5" r="3" fill="#ffb648" />
+        <path
+          d="M14 10h36a8 8 0 0 1 8 8v20a8 8 0 0 1-8 8H30l-9 8v-8h-7a8 8 0 0 1-8-8V18a8 8 0 0 1 8-8z"
+          fill="url(#mascot-body)"
+        />
+        <g className="mascot-eyes">
+          <ellipse cx="24" cy="26" rx="4" ry="5" fill="#fff" />
+          <ellipse cx="40" cy="26" rx="4" ry="5" fill="#fff" />
+          <circle cx="25" cy="27" r="2" fill="#2a0047" />
+          <circle cx="41" cy="27" r="2" fill="#2a0047" />
+        </g>
+        <path d="M27 36q5 4 10 0" stroke="#fff" strokeWidth="2.2" fill="none" strokeLinecap="round" />
+        <circle cx="18" cy="34" r="2.2" fill="#ff8ccf" opacity=".7" />
+        <circle cx="46" cy="34" r="2.2" fill="#ff8ccf" opacity=".7" />
+      </g>
+    </svg>
+  )
+}
+
+function HelperPanel({ onClose }: { onClose: () => void }) {
+  const { packs, startTour, payments, openInPanel, voiceOn, toggleVoice, trainees, activeTraineeId } = useStore()
+  const me = trainees.find((t) => t.id === activeTraineeId)
+  const [q, setQ] = useState('')
+  const [asked, setAsked] = useState('')
+  const [picked, setPicked] = useState<{ f: Faq; pack: TrainingPack } | null>(null)
+  const inputRef = useRef<HTMLInputElement>(null)
+  const all = useMemo(() => packs.flatMap((pack) => pack.faqs.map((f) => ({ f, pack }))), [packs])
+  const venue = useMemo(() => (asked ? answerVenue(asked, payments) : null), [asked, payments])
+  const results = asked
+    ? all.map((x) => ({ ...x, s: score(x.f, asked) })).filter((x) => x.s > 0).sort((a, b) => b.s - a.s).slice(0, venue ? 3 : 5)
+    : []
+
+  useEffect(() => inputRef.current?.focus(), [])
+
+  const ask = (text: string) => {
+    const t = text.trim()
+    setQ(t)
+    setAsked(t)
+    setPicked(null)
+    if (!t) return
+    const v = answerVenue(t, payments)
+    const top = all.map((x) => ({ ...x, s: score(x.f, t) })).sort((a, b) => b.s - a.s)[0]
+    if (voiceOn) speak(v ? v.text : top && top.s > 0 ? top.f.a : 'I don’t have an answer for that yet. Ask your manager.')
+  }
+  const mic = useListen(ask)
+
+  const show = (x: { f: Faq; pack: TrainingPack }) => {
+    if (!x.f.lesson) return
+    const [moduleId, lessonId] = x.f.lesson.split('/')
+    onClose()
+    startTour(x.pack.id, moduleId, lessonId)
+  }
+
+  return (
+    <div className="helper-panel ask" role="dialog" aria-label={`Ask ${BOT_NAME}`} data-tour="ask-box">
+      <div className="helper-head">
+        <Mascot size={34} />
+        <div className="grow">
+          <b>{BOT_NAME}</b>
+          <div className="muted tiny">Your Vendor Panel helper</div>
+        </div>
+        <button className="icon-btn" onClick={toggleVoice} title={voiceOn ? 'Answers are read aloud' : 'Voice off'}>
+          {voiceOn ? <IconVolume size={16} /> : <IconMute size={16} />}
+        </button>
+        <button className="icon-btn" onClick={onClose} title="Close" aria-label="Close">
+          <IconClose size={16} />
+        </button>
+      </div>
+
+      <div className="helper-body">
+        <div className="bot-bubble">
+          Hi{me ? ` ${me.name}` : ''}! Ask me how to do something, or about this venue’s numbers: takings, tips, payouts, a
+          guest’s card, tables that still owe.
+        </div>
+
+        {asked && <div className="me-bubble">{asked}</div>}
+
+        {picked ? (
+          <div className="answer">
+            <div className="answer-q">{picked.f.q}</div>
+            <p>{picked.f.a}</p>
+            <div className="row gap">
+              {picked.f.lesson && (
+                <button className="btn btn-primary small" onClick={() => show(picked)} data-tour="ask-show-me">
+                  <IconPlay size={12} /> Show me on the panel
+                </button>
+              )}
+              <button className="btn btn-text small" onClick={() => setPicked(null)}>
+                Back
+              </button>
+            </div>
+          </div>
+        ) : (
+          <>
+            {venue && (
+              <div className="answer data" data-tour="ask-data-answer">
+                <div className="eyebrow">FROM THIS VENUE'S DATA</div>
+                <p>{venue.text}</p>
+                {venue.lines && (
+                  <div className="answer-lines">
+                    {venue.lines.map(([a, b], i) => (
+                      <div key={i}>
+                        <span>{a}</span>
+                        <b>{b}</b>
+                      </div>
+                    ))}
+                  </div>
+                )}
+                {venue.note && <p className="muted small">{venue.note}</p>}
+                {venue.open && (
+                  <div className="row gap">
+                    <button
+                      className="btn btn-primary small"
+                      onClick={() => {
+                        onClose()
+                        openInPanel(venue.open!)
+                      }}
+                      data-tour="ask-open-panel"
+                    >
+                      <IconPlay size={12} /> {venue.open.label}
+                    </button>
+                  </div>
+                )}
+              </div>
+            )}
+            <div className="faq-list">
+              {asked && results.length > 0 && <div className="eyebrow">{venue ? 'RELATED HOW-TOS' : 'HOW-TOS'}</div>}
+              {asked && !venue && results.length === 0 && (
+                <div className="bot-bubble">I don't have an answer for that yet. Try other words, or ask your manager.</div>
+              )}
+              {results.map((x, i) => (
+                <button key={i} className="faq" onClick={() => setPicked(x)} data-tour={i === 0 ? 'ask-first-result' : undefined}>
+                  {x.f.q}
+                </button>
+              ))}
+              {!asked && (
+                <>
+                  <div className="eyebrow">HOW DO I…</div>
+                  {all.slice(0, 4).map((x, i) => (
+                    <button key={i} className="faq" onClick={() => setPicked(x)} data-tour={i === 0 ? 'ask-first-result' : undefined}>
+                      {x.f.q}
+                    </button>
+                  ))}
+                  <div className="eyebrow" style={{ marginTop: 6 }}>
+                    THIS VENUE'S NUMBERS
+                  </div>
+                  <div className="chips">
+                    {DATA_QUESTIONS.map((d) => (
+                      <button key={d} className="suggest" onClick={() => ask(d)}>
+                        {d}
+                      </button>
+                    ))}
+                  </div>
+                </>
+              )}
+            </div>
+          </>
+        )}
+      </div>
+
+      <div className="helper-foot">
+        {mic.listening && <div className="heard">Listening… ask your question</div>}
+        {mic.error && <div className="heard">{mic.error}</div>}
+        <form
+          className="input-wrap"
+          onSubmit={(e) => {
+            e.preventDefault()
+            ask(q)
+          }}
+        >
+          <IconSearch size={15} />
+          <input
+            ref={inputRef}
+            placeholder="e.g. Which tables still owe money?"
+            value={q}
+            onChange={(e) => {
+              setQ(e.target.value)
+              if (!e.target.value) setAsked('')
+            }}
+            data-tour="ask-input"
+          />
+          {mic.supported && (
+            <button
+              type="button"
+              className={`icon-btn ${mic.listening ? 'listening' : ''}`}
+              onClick={mic.listening ? mic.stop : mic.start}
+              title="Ask by voice"
+              data-tour="ask-mic"
+            >
+              <IconMic size={16} />
+            </button>
+          )}
+          <button type="submit" className="btn btn-primary small" data-tour="ask-submit">
+            Ask
+          </button>
+        </form>
+        <p className="muted tiny">Answers use the demo venue's 22 transactions, 19 Sep – 19 Oct.</p>
+      </div>
+    </div>
+  )
+}
