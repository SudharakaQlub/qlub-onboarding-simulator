new file mode 100644
index 0000000..1c2e556
--- /dev/null
+++ b/src/training/guides.ts
@@ -0,0 +1,185 @@
+// Turns a question into a short walkthrough on the real panel: Qi flies to each part of the
+// screen, points at it and says one line. Data answers come from the venue's transactions
+// export (venueAnswers.ts); how-to answers hand over to the matching training lesson.
+
+import type { Payment } from '../data/demoVenue'
+import { summarize } from '../data/orders'
+import { money, shortDay } from '../data/periods'
+import { matches } from '../pages/Payments'
+import type { PageKey, PanelPreset } from '../store'
+import type { Faq, TrainingPack } from './types'
+import { answerVenue, type VenueAnswer } from './venueAnswers'
+
+export interface GuideStep {
+  /** data-tour id to spotlight. None: Qi talks from the corner. */
+  target?: string
+  /** One short line, shown in Qi's bubble and read aloud. */
+  say: string
+  /** Put the panel in this state as the step starts (page, dates, filters). */
+  apply?: PanelPreset
+  /** Click this data-tour element for the trainee, as a demonstration (e.g. a menu item or tab). */
+  click?: string
+}
+
+export interface Guide {
+  question: string
+  /** The full answer, shown on the last step. */
+  answer: string
+  lines?: Array<[string, string]>
+  note?: string
+  steps: GuideStep[]
+  /** For how-to questions: the lesson to replay after Qi's intro. */
+  lesson?: { packId: string; moduleId: string; lessonId: string; title: string }
+}
+
+const NAV: Partial<Record<PageKey, string>> = { dashboard: 'Dashboard', orders: 'Orders', payments: 'Payments', tableView: 'Table View' }
+
+function nav(page: PageKey, why: string, current: PageKey): GuideStep[] {
+  if (current === page) return []
+  return [{ target: `nav-${page}`, say: `${why} live on ${NAV[page]}. Opening it from the menu.`, click: `nav-${page}` }]
+}
+
+/** "in the last 30 days" → "the last 30 days", so it reads well after "set the dates to". */
+const plain = (range?: string) => (range ?? 'in the last 30 days').replace(/^(in|on) /, '')
+
+function dates(a: VenueAnswer, page: PageKey): GuideStep {
+  return {
+    target: 'date-button',
+    apply: a.open ? { ...a.open, page } : { page },
+    say: `I've set the dates to ${plain(a.range)}. You change them with this button.`,
+  }
+}
+
+const STOP = new Set(['the', 'and', 'how', 'what', 'did', 'does', 'was', 'were', 'are', 'can', 'for', 'our', 'this', 'that', 'last', 'week', 'month', 'days', 'with', 'from', 'will', 'have', 'has', 'get', 'see', 'you', 'they', 'their', 'who', 'which', 'why', 'when', 'today', 'yesterday', 'much', 'many', 'show', 'tell', 'please', 'qi'])
+
+function scoreFaq(f: Faq, q: string) {
+  const words = q.toLowerCase().split(/\W+/).filter((w) => w.length > 2 && !STOP.has(w))
+  if (!words.length) return 0
+  const hay = `${f.q} ${(f.keywords ?? []).join(' ')}`.toLowerCase()
+  const body = f.a.toLowerCase()
+  return words.reduce((s, w) => s + (hay.includes(w) ? 2 : body.includes(w) ? 1 : 0), 0)
+}
+
+/** Questions that are clearly "how do I…" go to a lesson even if they mention money words. */
+const HOW_TO = /^\s*(how (do|can|would|should) (i|we|you)|how to|where (do|can|is)|what does|what's the difference|show me how|teach me|can i)\b/i
+
+export function buildGuide(question: string, payments: Payment[], packs: TrainingPack[], current: PageKey): Guide | null {
+  const q = question.trim()
+  if (!q) return null
+  const faqs = packs.flatMap((pack) => pack.faqs.map((f) => ({ f, pack, s: scoreFaq(f, q) }))).sort((a, b) => b.s - a.s)
+  const bestFaq = faqs[0] && faqs[0].s >= 2 ? faqs[0] : null
+
+  const a = HOW_TO.test(q) && bestFaq ? null : answerVenue(q, payments)
+  if (a) return dataGuide(q, a, payments, current)
+
+  if (bestFaq) {
+    const { f, pack } = bestFaq
+    const [moduleId, lessonId] = (f.lesson ?? '').split('/')
+    const mod = pack.modules.find((m) => m.id === moduleId)
+    const lesson = mod?.lessons.find((l) => l.id === lessonId)
+    return {
+      question: q,
+      answer: f.a,
+      steps: [{ say: f.a }],
+      lesson: mod && lesson ? { packId: pack.id, moduleId, lessonId, title: lesson.title } : undefined,
+    }
+  }
+  return null
+}
+
+function dataGuide(q: string, a: VenueAnswer, payments: Payment[], current: PageKey): Guide {
+  const base = { question: q, answer: a.text, lines: a.lines, note: a.note }
+  const steps: GuideStep[] = []
+
+  switch (a.kind) {
+    case 'revenue':
+      steps.push(...nav('dashboard', 'Takings', current), dates(a, 'dashboard'))
+      steps.push({ target: 'kpi-revenue', say: a.text })
+      steps.push({ target: 'tab-revenue', say: 'The chart shows revenue day by day. Tap a day to see how guests paid.' })
+      break
+    case 'tips':
+      steps.push(...nav('dashboard', 'Tips', current), dates(a, 'dashboard'))
+      steps.push({ target: 'kpi-tips', say: a.text })
+      steps.push({ target: 'tab-tips', click: 'tab-tips', say: 'Switch the chart to Tips to see them day by day.' })
+      break
+    case 'payout':
+      steps.push(...nav('dashboard', 'Payouts', current), dates(a, 'dashboard'))
+      steps.push({ target: 'payout-breakdown', say: 'Here’s how it adds up: revenue, plus tips and loyalty credit, minus qlub’s Vendor Fee.' })
+      steps.push({ target: 'payout-total', say: a.text })
+      break
+    case 'fees':
+      steps.push(...nav('dashboard', 'Fees', current), dates(a, 'dashboard'))
+      if (a.focus !== 'diner') steps.push({ target: 'kpi-vendorfee', say: a.focus === 'vendor' ? a.text : 'The Vendor Fee is qlub’s commission. It comes off the payout.' })
+      if (a.focus !== 'vendor') steps.push({ target: 'kpi-dinerfee', say: a.focus === 'diner' ? a.text : 'The Diner Fee is paid by guests on top of the bill and goes to qlub.' })
+      if (a.focus === 'both') steps.push({ say: a.text })
+      break
+    case 'refunds':
+      steps.push(...nav('dashboard', 'Refunds', current), dates(a, 'dashboard'))
+      steps.push({ target: 'kpi-refunds', say: a.text })
+      break
+    case 'loyalty':
+      steps.push(...nav('dashboard', 'Loyalty credit', current), dates(a, 'dashboard'))
+      steps.push({ target: 'payout-breakdown', say: a.text })
+      break
+    case 'busiest':
+      steps.push(...nav('dashboard', 'Daily takings', current), dates(a, 'dashboard'))
+      steps.push({ target: `chart-day-${a.focus}`, say: a.text })
+      steps.push({ target: 'card-split', say: `And this is how guests paid on ${shortDay(a.focus!)}.` })
+      break
+    case 'popular':
+      steps.push(...nav('dashboard', 'Best sellers', current))
+      steps.push({ target: 'popular-items', apply: { page: 'dashboard' }, say: a.text })
+      break
+    case 'brands':
+      if (a.focus) {
+        steps.push(...nav('dashboard', 'Card brands', current))
+        steps.push({ target: `chart-day-${a.focus}`, apply: a.open, say: `I've picked ${shortDay(a.focus)} on the chart.` })
+        steps.push({ target: 'card-split', say: a.text })
+      } else {
+        steps.push(...nav('payments', 'Card details', current), dates(a, 'payments'))
+        steps.push({ target: 'payments-col-method', say: a.text })
+      }
+      break
+    case 'owe': {
+      steps.push(...nav('orders', 'Unpaid bills', current))
+      steps.push({ target: 'orders-status-filter', apply: a.open, say: `I've filtered Orders to Partially Paid bills from ${plain(a.range)}.` })
+      steps.push({ target: 'orders-col-status', say: 'Partially Paid means part of the bill is still to pay. The Remaining column shows how much.' })
+      steps.push({ target: 'orders-table', say: a.text })
+      break
+    }
+    case 'order':
+      steps.push(...nav('orders', 'Bills', current))
+      steps.push({ target: 'orders-id-search', apply: { page: 'orders', period: { key: 'last30' }, orderId: a.focus }, say: `Search by the order number from the receipt. I've opened order ${a.focus}.` })
+      steps.push({ target: 'order-payments', say: 'Every payment on this bill is listed here.' })
+      steps.push({ target: 'order-remaining', say: a.text })
+      break
+    case 'card':
+    case 'amount': {
+      const first = payments.find((p) => (a.kind === 'card' ? p.last4 === a.focus : matches(p, a.focus!)))
+      steps.push(...nav('payments', 'Guest payments', current))
+      steps.push({ target: 'payments-search', apply: a.open, say: `I've searched Payments for ${a.kind === 'card' ? `the card ending ${a.focus}` : money(Number(a.focus))}, over ${plain(a.range)}.` })
+      steps.push({ target: first ? `payment-row-${first.id}` : 'payments-table', say: a.text })
+      break
+    }
+    case 'average':
+    case 'count': {
+      const latest = summarize(payments)[0]
+      steps.push(...nav('orders', 'Bills', current))
+      steps.push({ target: 'date-button', apply: a.open, say: `I've set the dates to ${plain(a.range)}. Each row is one bill.` })
+      steps.push({ target: latest ? `order-row-${latest.id}` : 'orders-table', say: a.text })
+      break
+    }
+    default:
+      steps.push({ say: a.text })
+  }
+  return { ...base, steps }
+}
+
+export const EXAMPLES = [
+  'How much did we make last week?',
+  'What were tips this month?',
+  'Which tables still owe money?',
+  'What will we be paid?',
+  'Find the card ending 4242',
+  'How do I issue a refund?',
+]
